# ==============================================================================
# NORTHUP STUDIO — Environment Variables Configuration Template
# Phase 3: Production Client Enquiry & Supabase Storage
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Backend Configuration (Required for /api/contact & Database Storage)
# ------------------------------------------------------------------------------
# In Supabase: Project Settings -> API
# - Project URL: Copy and set as SUPABASE_URL
# - Project API keys -> service_role (secret): Copy and set as SUPABASE_SERVICE_ROLE_KEY
# 
# IMPORTANT: The SUPABASE_SERVICE_ROLE_KEY must ONLY be added to Vercel Environment
# Variables or local .env for server-side functions. It is NEVER exposed to the browser.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# Client-facing Supabase variables (Optional, only used if querying public tables)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key

# ------------------------------------------------------------------------------
# 2. Admin Authentication & Allowlist (Phase 4)
# ------------------------------------------------------------------------------
# Comma-separated list of approved admin emails. Only authenticated users whose
# email appears here or in the public.admin_users table can access the dashboard.
ADMIN_EMAILS=northup4work@gmail.com,your-admin-email@domain.com

# ------------------------------------------------------------------------------
# 3. Email Notifications & Confirmation via Resend (Phase 4 Automation)
# ------------------------------------------------------------------------------
# If configured, /api/contact dispatches:
# A) An immediate admin alert with link to /admin
# B) A branded acknowledgement to the prospective client
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_TO_EMAIL=northup4work@gmail.com
CONTACT_NOTIFICATION_EMAIL=northup4work@gmail.com
RESEND_FROM_EMAIL=Northup Studio <enquiries@northupstudio.vercel.app>

# ------------------------------------------------------------------------------
# 4. Production Domain Reference
# ------------------------------------------------------------------------------
VITE_SITE_URL=https://northupstudio.vercel.app
